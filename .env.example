# ---- shared by web, realtime and indexer
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/insider
REDIS_URL=redis://127.0.0.1:6379
# Long random string; signs session cookies. The realtime service must use the same value.
SESSION_SECRET=change-me-to-64-random-characters

# 84532 = Base Sepolia, 8453 = Base
NEXT_PUBLIC_CHAIN_ID=84532
# Server-side RPC (paid provider in production; comma-separate several for fallback)
RPC_URLS=https://sepolia.base.org
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# From contracts/script/Deploy.s.sol
NEXT_PUBLIC_KEYS_ADDRESS=
NEXT_PUBLIC_ROOM_ACCESS_ADDRESS=
NEXT_PUBLIC_SPLITTER_FACTORY_ADDRESS=
# Block the contracts were deployed at (the indexer starts here)
START_BLOCK=0

# ---- web
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Where the browser opens the chat socket
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001
# Base Builder Code (ERC-8021), appended to every transaction we send
NEXT_PUBLIC_BUILDER_CODE=
# 0x Swap API (in-app swaps; fee goes to the room's splitter)
ZEROX_API_KEY=
SWAP_FEE_BPS=100

# ---- realtime
REALTIME_PORT=4001
